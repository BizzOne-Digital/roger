NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/redrosephotobooth?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://www.redrosephotobooth.com
# Optional comma-separated extra browser origins (preview URLs, etc.)
# CORS_EXTRA_ORIGINS=
# API-only deploy (Vercel backend + separate frontend): leave SERVE_FRONTEND unset or false
# SERVE_FRONTEND=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=Roger@redrosephotobooth.com
ADMIN_SEED_EMAIL=admin@redrosephotobooth.com
ADMIN_SEED_PASSWORD=ChangeThisPassword123!

# Frontend (Vite) — dev only; production uses .env.production or Vercel env
VITE_API_BASE_URL=http://localhost:5000/api
# Vercel (same project as API): use /api — do not point at *.vercel.app or CORS breaks on the custom domain
# BoothBook — public customer booking / checkout URL (from BoothBook “share” or website link)
# Do not use Check Cherry URLs. Leave empty or /booking until BoothBook is ready.
VITE_BOOKING_URL=
# Leave empty or set to /booking to use the on-site request form until BoothBook URL is ready
