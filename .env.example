NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/redrosephotobooth?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://your-production-domain.com
# API-only deploy (Vercel backend + separate frontend): leave SERVE_FRONTEND unset or false
# SERVE_FRONTEND=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=Roger@redrosephotobooth.com
ADMIN_SEED_EMAIL=admin@redrosephotobooth.com
ADMIN_SEED_PASSWORD=ChangeThisPassword123!

# Frontend (Vite) — dev only; production uses .env.production or Vercel env
VITE_API_BASE_URL=http://localhost:5000/api
# Check Cherry — public booking link (NOT the /admin/ URL).
# Roger: CheckCherry → Packages / Website Integration → copy the customer “Share” link
# (all packages). Default below matches the booking engine package picker.
VITE_BOOKING_URL=https://red-rose-photo-booth-llc.checkcherry.com/reservation
# Per-package links: paste that package’s Share URL here, or set multiple CTAs in code later.
# Use VITE_BOOKING_URL=/booking to restore the on-site request form only

# Check Cherry website widgets (public embed key from Website Integration)
# VITE_CHECKCHERRY_HOST=https://red-rose-photo-booth-llc.checkcherry.com
# VITE_CHECKCHERRY_API_KEY=RYR-K44P-C3G
